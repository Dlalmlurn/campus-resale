# 生产环境变量示例。复制为 .env.prod 后填入真实值，切勿提交真实密钥到仓库。
# 用法：docker compose --env-file .env.prod -f compose.prod.yaml up -d --build

# 公网域名与 ACME 邮箱（Caddy 自动申请 Let's Encrypt 证书使用）
PUBLIC_DOMAIN=campus.example.edu
ACME_EMAIL=ops@example.edu

# PostgreSQL（务必替换为强密码，不要沿用开发默认值）
POSTGRES_DB=campus_resale
POSTGRES_USER=campus_resale
POSTGRES_PASSWORD=please-change-this-strong-password

# MinIO 对象存储（务必替换为强密钥）
MINIO_ROOT_USER=campus_resale_minio
MINIO_ROOT_PASSWORD=please-change-this-strong-secret
MINIO_BUCKET=campus-resale

# AI 发布辅助（DeepSeek，OpenAI 兼容）。
# 留空 CAMPUS_RESALE_AI_API_KEY 或 enabled=false 时，后端自动退回稳健规则引擎。
CAMPUS_RESALE_AI_ENABLED=false
CAMPUS_RESALE_AI_PROVIDER=deepseek
CAMPUS_RESALE_AI_BASE_URL=https://api.deepseek.com
CAMPUS_RESALE_AI_API_KEY=
CAMPUS_RESALE_AI_MODEL=deepseek-chat
